# ============================================
# FRONTEND ENVIRONMENT VARIABLES (.env.local)
# ============================================

# API Base URL
# Local development: http://localhost:5000
# Production (Vercel): https://your-project.vercel.app/api
VITE_API_URL=http://localhost:5000/api

# OpenRouter API Key for AI features
# Get your key from: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here


# ============================================
# BACKEND ENVIRONMENT VARIABLES (server/.env)
# ============================================

# MongoDB Connection String
# Local: mongodb://localhost:27017/codex
# Production: Use MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Codex

# JWT Secret Key (use a strong random string)
# Generate one: openssl rand -base64 32
JWT_SECRET=your_secure_random_jwt_secret_key_here

# Server Port
PORT=5000


# ============================================
# PRODUCTION DEPLOYMENT (Vercel)
# ============================================

# Set these in Vercel Dashboard → Settings → Environment Variables:
#
# Frontend Variables:
# - VITE_API_URL = https://your-project.vercel.app/api
# - VITE_OPENROUTER_API_KEY = your_openrouter_key
#
# Backend Variables:
# - MONGODB_URI = your_mongodb_atlas_connection_string
# - JWT_SECRET = your_secure_random_string
# - PORT = 5000
# - VERCEL = 1


# ============================================
# NOTES
# ============================================

# 1. Never commit .env files to git (already in .gitignore)
# 2. Copy this file to .env.local and server/.env
# 3. Replace placeholder values with your actual credentials
# 4. For MongoDB Atlas:
#    - Create a free cluster at https://www.mongodb.com/cloud/atlas
#    - Whitelist all IPs (0.0.0.0/0) for Vercel
#    - Create a database user with read/write permissions
# 5. For OpenRouter:
#    - Sign up at https://openrouter.ai
#    - Get API key from https://openrouter.ai/keys
#    - Model used: kwaipilot/kat-coder-pro:free
